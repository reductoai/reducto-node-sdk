{
  "name": "reductoai",
  "version": "0.17.0",
  "description": "The official TypeScript library for the Reducto API",
  "author": "Reducto <dev-feedback@reductoai.com>",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": "github:reductoai/reducto-node-sdk",
  "license": "Apache-2.0",
  "files": [
    "**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test tests/*.test.ts",
    "test:e2e": "bun test tests/e2e",
    "build": "./scripts/build",
    "bump-version": "bun run scripts/bump-version.ts",
    "lint": "bun run lint:eslint && bun run lint:types",
    "lint:eslint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext ts,js .",
    "lint:types": "tsc --noEmit",
    "format": "ESLINT_USE_FLAT_CONFIG=false eslint --fix --ext ts,js . && prettier --write --cache --cache-strategy metadata . \"!dist\"",
    "prepublishOnly": "echo 'to publish, run bun run build && (cd dist; npm publish)' && exit 1"
  },
  "dependencies": {
    "@types/node": "^18.11.18",
    "@types/node-fetch": "^2.6.4",
    "abort-controller": "^3.0.0",
    "agentkeepalive": "^4.2.1",
    "form-data-encoder": "1.7.2",
    "formdata-node": "^4.3.2",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "iconv-lite": "^0.6.3",
    "prettier": "^3.0.0",
    "tsc-multi": "^1.1.0",
    "typescript": "^5.9.0"
  },
  "sideEffects": [
    "./_shims/index.js",
    "./_shims/index.mjs",
    "./shims/node.js",
    "./shims/node.mjs",
    "./shims/web.js",
    "./shims/web.mjs"
  ],
  "exports": {
    "./_shims/auto/*": {
      "deno": {
        "types": "./dist/_shims/auto/*.d.ts",
        "require": "./dist/_shims/auto/*.js",
        "default": "./dist/_shims/auto/*.mjs"
      },
      "bun": {
        "types": "./dist/_shims/auto/*.d.ts",
        "require": "./dist/_shims/auto/*-bun.js",
        "default": "./dist/_shims/auto/*-bun.mjs"
      },
      "browser": {
        "types": "./dist/_shims/auto/*.d.ts",
        "require": "./dist/_shims/auto/*.js",
        "default": "./dist/_shims/auto/*.mjs"
      },
      "worker": {
        "types": "./dist/_shims/auto/*.d.ts",
        "require": "./dist/_shims/auto/*.js",
        "default": "./dist/_shims/auto/*.mjs"
      },
      "workerd": {
        "types": "./dist/_shims/auto/*.d.ts",
        "require": "./dist/_shims/auto/*.js",
        "default": "./dist/_shims/auto/*.mjs"
      },
      "node": {
        "types": "./dist/_shims/auto/*-node.d.ts",
        "require": "./dist/_shims/auto/*-node.js",
        "default": "./dist/_shims/auto/*-node.mjs"
      },
      "types": "./dist/_shims/auto/*.d.ts",
      "require": "./dist/_shims/auto/*.js",
      "default": "./dist/_shims/auto/*.mjs"
    },
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*.mjs": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.mjs"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.mjs"
    }
  }
}
